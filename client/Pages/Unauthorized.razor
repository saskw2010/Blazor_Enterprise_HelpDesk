@page "/unauthorized"
@layout MainLayout
@inherits Cpdhelpdesk.Pages.UnauthorizedComponent

@using Radzen
@using Radzen.Blazor
@using Cpdhelpdesk.Models.Authenticationconn
@using Cpdhelpdesk.Models
@using Microsoft.AspNetCore.Authorization
@inject Microsoft.Extensions.Localization.IStringLocalizer<Unauthorized> L
<PageTitle>Unauthorized</PageTitle>
<RadzenContent Container="main">
  <ChildContent>
    <RadzenHeading Size="H1" Text="@L["pageTitle.Text"]">
    </RadzenHeading>
    <div class="row">
      <div class="col-md-12">
        <RadzenHtml>
          The current user is not authorized to see this page.
        </RadzenHtml>
      </div>
    </div>
  </ChildContent>
</RadzenContent>
