@page "/localization-resources"
@layout MainLayout
@inherits Cpdhelpdesk.Pages.LocalizationResourcesComponent

@using Radzen
@using Radzen.Blazor
@using Cpdhelpdesk.Models.Authenticationconn
@using Cpdhelpdesk.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject Microsoft.Extensions.Localization.IStringLocalizer<LocalizationResources> L
<PageTitle>Localization Resources</PageTitle>
<RadzenContent Container="main">
  <ChildContent>
    <RadzenHeading Size="H1" Text="@L["pageTitle.Text"]">
    </RadzenHeading>
    <div class="row">
      <div class="col-md-12">
        <RadzenButton Icon="add_circle_outline" style="margin-bottom: 10px" Text="@L["button0.Text"]" Click="@Button0Click">
        </RadzenButton>
        <RadzenSplitButton Icon="get_app" style="margin-left: 10px; margin-bottom: 10px" Text="@L["splitbutton0.Text"]" Click="@Splitbutton0Click">
          <ChildContent>
            <RadzenSplitButtonItem Text="@L["splitbutton0.excel.Text"]" Value="xlsx">
            </RadzenSplitButtonItem>
            <RadzenSplitButtonItem Text="@L["splitbutton0.csv.Text"]" Value="csv">
            </RadzenSplitButtonItem>
          </ChildContent>
        </RadzenSplitButton>
        <RadzenTextBox Placeholder="@L["textbox0.Placeholder"]" style="display: block; margin-bottom: 10px; width: 100%" Name="Textbox0" @oninput="@(async(args) => {search = $"{args.Value}";await grid0.GoToPage(0);await grid0.Reload();})">
        </RadzenTextBox>
        <RadzenDataGrid @ref="grid0" AllowFiltering="true" FilterMode="Radzen.FilterMode.Advanced" AllowPaging="true" AllowSorting="true" Data="@getLocalizationResourcesResult" Count="@getLocalizationResourcesCount" TItem="Cpdhelpdesk.Models.Authenticationconn.LocalizationResource" LoadData="@Grid0LoadData" RowDoubleClick="@Grid0RowDoubleClick">
          <Columns>
            <RadzenDataGridColumn TItem="Cpdhelpdesk.Models.Authenticationconn.LocalizationResource" Property="Id" Title="@L["grid0.Id.Title"]">
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Cpdhelpdesk.Models.Authenticationconn.LocalizationResource" Property="Author" Title="@L["grid0.Author.Title"]">
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Cpdhelpdesk.Models.Authenticationconn.LocalizationResource" Property="FromCode" Title="@L["grid0.FromCode.Title"]">
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Cpdhelpdesk.Models.Authenticationconn.LocalizationResource" Property="IsHidden" Title="@L["grid0.IsHidden.Title"]">
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Cpdhelpdesk.Models.Authenticationconn.LocalizationResource" Property="IsModified" Title="@L["grid0.IsModified.Title"]">
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Cpdhelpdesk.Models.Authenticationconn.LocalizationResource" Property="ModificationDate" FormatString="{0:MM/dd/yyyy}" Title="@L["grid0.ModificationDate.Title"]">
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Cpdhelpdesk.Models.Authenticationconn.LocalizationResource" Property="ResourceKey" Title="@L["grid0.ResourceKey.Title"]">
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Cpdhelpdesk.Models.Authenticationconn.LocalizationResource" Property="Notes" Title="@L["grid0.Notes.Title"]">
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Cpdhelpdesk.Models.Authenticationconn.LocalizationResource" Filterable="false" Sortable="false" Width="70px" TextAlign="TextAlign.Center">
              <Template Context="cpdhelpdeskModelsAuthenticationconnLocalizationResource">
                <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="close" Size="ButtonSize.Small" Click="@((args) =>GridDeleteButtonClick(args, cpdhelpdeskModelsAuthenticationconnLocalizationResource))" @onclick:stopPropagation="true">
                </RadzenButton>
              </Template>
            </RadzenDataGridColumn>
          </Columns>
        </RadzenDataGrid>
      </div>
    </div>
  </ChildContent>
</RadzenContent>
