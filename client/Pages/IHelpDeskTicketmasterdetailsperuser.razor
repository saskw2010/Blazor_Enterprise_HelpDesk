@page "/i-help-desk-ticketmasterdetailsperuser"
@layout WidelayoutLayout
@inherits Cpdhelpdesk.Pages.IHelpDeskTicketmasterdetailsperuserComponent

@using Radzen
@using Radzen.Blazor
@using Cpdhelpdesk.Models.Authenticationconn
@using Cpdhelpdesk.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject Microsoft.Extensions.Localization.IStringLocalizer<IHelpDeskTicketmasterdetailsperuser> L
<PageTitle>IHelpDeskTicketmasterdetailsperuser</PageTitle>
<RadzenContent Container="main">
  <ChildContent>
    <RadzenHeading Size="H1" Text="@L["pageTitle.Text"]">
    </RadzenHeading>
    <div class="row">
      <div class="col-md-12">
        <RadzenTextBox Placeholder="@L["textbox0.Placeholder"]" style="display: block; margin-bottom: 10px; width: 100%" Name="Textbox0" @oninput="@(async(args) => {search = $"{args.Value}";await grid0.GoToPage(0);await grid0.Reload();})">
        </RadzenTextBox>
        <RadzenDataGrid @ref="grid0" AllowFiltering="false" AllowGrouping="false" AllowPaging="true" AllowSorting="true" AllowVirtualization="false" Count="@getHelpDeskTicketsCount" Data="@getHelpDeskTicketsResult" ExpandMode="DataGridExpandMode.Multiple" FilterMode="Radzen.FilterMode.Advanced" TItem="Cpdhelpdesk.Models.Authenticationconn.HelpDeskTicket" SelectionMode="DataGridSelectionMode.Multiple" LoadData="@Grid0LoadData" RowExpand="@Grid0RowExpand">
          <Columns>
            <RadzenDataGridColumn TItem="Cpdhelpdesk.Models.Authenticationconn.HelpDeskTicket" Property="TicketDescription" Title="@L["grid0.TicketDescription.Title"]">
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Cpdhelpdesk.Models.Authenticationconn.HelpDeskTicket" FilterProperty="HelpDeskStatus.TicketStatusDesc" GroupProperty="HelpDeskStatus.TicketStatusDesc" Property="TicketStatus" SortProperty="HelpDeskStatus.TicketStatusDesc" Title="@L["grid0.TicketStatus.Title"]">
              <Template Context="data">
              @(data.HelpDeskStatus?.TicketStatusDesc)
              </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Cpdhelpdesk.Models.Authenticationconn.HelpDeskTicket" FormatString="{0:d}" Property="TicketDate" Title="@L["grid0.TicketDate.Title"]">
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Cpdhelpdesk.Models.Authenticationconn.HelpDeskTicket" FilterProperty="LocationList.locationDesc" GroupProperty="LocationList.locationDesc" Property="locationID" SortProperty="LocationList.locationDesc" Title="@L["grid0.locationID.Title"]">
              <Template Context="data">
              @(data.LocationList?.locationDesc)
              </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Cpdhelpdesk.Models.Authenticationconn.HelpDeskTicket" FilterProperty="ServiceCatglist.ServiceCatgDesc" GroupProperty="ServiceCatglist.ServiceCatgDesc" Property="ServiceCatgID" SortProperty="ServiceCatglist.ServiceCatgDesc" Title="@L["grid0.ServiceCatgID.Title"]">
              <Template Context="data">
              @(data.ServiceCatglist?.ServiceCatgDesc)
              </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Cpdhelpdesk.Models.Authenticationconn.HelpDeskTicket" FilterProperty="ServicesList.ServiceDesc" GroupProperty="ServicesList.ServiceDesc" Property="ServiceID" SortProperty="ServicesList.ServiceDesc" Title="@L["grid0.ServiceID.Title"]">
              <Template Context="data">
              @(data.ServicesList?.ServiceDesc)
              </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Cpdhelpdesk.Models.Authenticationconn.HelpDeskTicket" Property="Id" Title="@L["grid0.Id.Title"]">
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Cpdhelpdesk.Models.Authenticationconn.HelpDeskTicket" Property="TicketRequesterEmail" Title="@L["grid0.TicketRequesterEmail.Title"]">
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Cpdhelpdesk.Models.Authenticationconn.HelpDeskTicket" Property="TicketRequesterUser" Title="@L["grid0.TicketRequesterUser.Title"]">
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Cpdhelpdesk.Models.Authenticationconn.HelpDeskTicket" Property="TicketResponseUser" Title="@L["grid0.TicketResponseUser.Title"]">
            </RadzenDataGridColumn>
          </Columns>
          <Template Context="cpdhelpdeskModelsAuthenticationconnHelpDeskTicket">
            <RadzenDataGrid @ref="grid1" AllowFiltering="false" AllowPaging="true" AllowSorting="true" ColumnWidth="auto" Data="@(cpdhelpdeskModelsAuthenticationconnHelpDeskTicket.HelpDeskTicketDetails)" EmptyText="@L["grid1.EmptyText"]" FilterMode="Radzen.FilterMode.Advanced" TItem="Cpdhelpdesk.Models.Authenticationconn.HelpDeskTicketDetail" style="height: 754px">
              <Columns>
                <RadzenDataGridColumn TItem="Cpdhelpdesk.Models.Authenticationconn.HelpDeskTicketDetail" FormatString="{0:d}" Frozen="false" Groupable="false" Property="TicketDetailDate" Reorderable="false" Resizable="true" Title="@L["grid1.TicketDetailDate.Title"]" Width="100px">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Cpdhelpdesk.Models.Authenticationconn.HelpDeskTicketDetail" Property="TicketDescription" Title="@L["grid1.TicketDescription.Title"]">
                </RadzenDataGridColumn>
              </Columns>
            </RadzenDataGrid>
          </Template>
        </RadzenDataGrid>
      </div>
    </div>
  </ChildContent>
</RadzenContent>


