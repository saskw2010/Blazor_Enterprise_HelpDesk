@page "/i-soft-1"
@layout LandingpageLayout
@inherits Cpdhelpdesk.Pages.ISoft1Component

@using Radzen
@using Radzen.Blazor
@using Cpdhelpdesk.Models.Authenticationconn
@using Cpdhelpdesk.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject Microsoft.Extensions.Localization.IStringLocalizer<ISoft1> L
<PageTitle>ISoft1</PageTitle>
<RadzenContent Container="main">
  <ChildContent>
    <div class="row">
      <div class="col-md-12">
        <RadzenProfileMenu style="display: inline-block; float: right; height: 39px; margin-top: 1px; width: 200px" Visible="@(Security.IsAuthenticated())" Top="0px" min-width="250px" clas="profilemenumos">
          <ChildContent>
            <RadzenProfileMenuItem Text="@L["profilemenu0.logout.Text"]" Value="Logout" Icon="power_settings_new">
            </RadzenProfileMenuItem>
          </ChildContent>
          <Template>
            <RadzenLabel Text="@($"{(Security.User?.Name)}")">
            </RadzenLabel>
          </Template>
        </RadzenProfileMenu>
        <RadzenHeading Size="H1" style="text-align: center" class="Headerbartest">
        </RadzenHeading>
      </div>
    </div>
    <div class="row">
      <div class="col-md-12">
        <RadzenDataList @ref="datalist0" AllowPaging="true" Count="@getsoftcatcount" Data="@getsoftcategory" TItem="Cpdhelpdesk.Models.Authenticationconn.SoftwareModulescatlist" PageSize="98" style="display: flex" WrapItems="true" LoadData="@Datalist0LoadData" class="slide-container-section__slide-main get-started-section">
          <Template Context="data">
          <RadzenCard class="flip-card">
          
          <div class="get-started-section">
          <div class="get-started-section__cards">
          <div class="get-started-section__card-number">
          <span>@data.sprModulecatid</span>
          </div>
          <div class="flip-card-inner">
          
          <div class="flip-card-front">
          
          <div class="first hero">
            <img class="hero-profile-img" src="@data.photopath" alt="" />
            <div class="hero-description-bk"></div>
            <div class="hero-logo">
                <img src="assets/images/cpd_logo.png" alt="" />
            </div>
            <div class="hero-description">
              <p> @data.FuturecatDesc1  </p>
            </div>
            
            
          
          
           
          </div>
          
          
          
          
          </div>
            
           <div class="flip-card-back">
           <div class="secondary hero">
            <img class="hero-profile-img" src="@data.photopath" alt="" />
            <div class="hero-description-bk"></div>
            <div class="hero-description-mos">
            <p> @data.FuturecatDesc  </p>
            </div>
            <div class="hero-logo">
                <img src="assets/images/cpd_logo.png" alt="" />
            </div>
           
            <div class="hero-btn1">
            
             <!-- <a href="@data.FuturecatDesc" target='_blank'>  <div class="get-started-section__card-button"><h3> @data.sprModulecatDesc </h3></div></a> -->
          	<!--<button href="@data.FuturecatDesc" target='_blank'	>@data.sprModulecatDesc</button>	-->
              <div class="buttons">
              <button  class="btn-hover color-8"><a href="@data.FuturecatDesc" target='_blank'>@data.sprModulecatDesc</a></button>
              </div>
          </div>
            
           						
          						
           </div>
                                          
                                       
            
            </div>  
            
           
           
           
           </div>  
           
          
          
          
          
          
          
          
           </div> 
             </div> 
          
                                          
                                          
                                          
                                            
           </RadzenCard>
          </Template>
        </RadzenDataList>
      </div>
    </div>
  </ChildContent>
</RadzenContent>


