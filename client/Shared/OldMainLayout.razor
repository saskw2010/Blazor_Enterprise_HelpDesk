@inherits Cpdhelpdesk.Layouts.OldMainLayoutComponent

@using Radzen
@using Radzen.Blazor
@using Cpdhelpdesk.Models.Authenticationconn
@using Cpdhelpdesk.Models
@using Cpdhelpdesk.Pages
@inject Microsoft.Extensions.Localization.IStringLocalizer<OldMainLayout> L
<RadzenDialog />
<RadzenNotification />
<RadzenTooltip />
<RadzenContextMenu />

<RadzenHeader>
  <ChildContent>
    <div class="row justify-content-start align-items-center" style="background-color: #414141">
      <div class="col-6 d-flex align-items-center" style="background-color: rgba(65, 65, 65, 0)">
        <RadzenSidebarToggle Click="@SidebarToggle0Click">
        </RadzenSidebarToggle>
        <RadzenLabel Text="@L["label0.Text"]">
        </RadzenLabel>
      </div>
      <div class="col-6 text-right" style="background-color: rgba(65, 65, 65, 0)">
        <RadzenDropDown Data="@(new[] { new { Text="Arabic - Kuwait", Value="ar-KW" },new { Text="English - United States", Value="en-US" }})" style="height: 41px" TextProperty="Text" @bind-Value="@Culture" ValueProperty="Value" Name="Dropdown1" Change="@Dropdown1Change">
        </RadzenDropDown>
        <RadzenProfileMenu style="display: inline-block; float: right; height: 39px; width: 200px" Visible="@(Security.IsAuthenticated())">
          <ChildContent>
            <RadzenProfileMenuItem Text="@L["profilemenu0.logout.Text"]" Value="Logout" Icon="power_settings_new">
            </RadzenProfileMenuItem>
          </ChildContent>
          <Template>
            <RadzenLabel Text="@($"{(Security.User?.Name)}")">
            </RadzenLabel>
          </Template>
        </RadzenProfileMenu>
      </div>
    </div>
  </ChildContent>
</RadzenHeader>
<RadzenBody @ref="body0">
  <ChildContent>
    <RadzenContentContainer Name="main">
    @Body
    </RadzenContentContainer>
  </ChildContent>
</RadzenBody>
<RadzenSidebar @ref="sidebar0" style="background-color: #414141">
  <ChildContent>
    <RadzenPanelMenu style="display: block; height: 100%">
