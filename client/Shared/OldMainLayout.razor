            </RadzenPanelMenuItem>
            <RadzenPanelMenuItem Path="help-desk-tickets" Text="@L["help-desk-tickets.Text"]">
            </RadzenPanelMenuItem>
            <RadzenPanelMenuItem Path="help-desk-ticket-details" Text="@L["help-desk-ticket-details.Text"]">
            </RadzenPanelMenuItem>
            <RadzenPanelMenuItem Path="software-modulescatlist" Text="@L["software-modulescatlist.Text"]">
