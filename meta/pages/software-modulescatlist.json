{
  "access": "Authenticated",
  "components": [
    {
      "components": [
        {
          "name": "pageTitle",
          "size": "H1",
          "text": "SoftwareModulescatlist",
          "type": "heading"
        },
        {
          "components": [
            {
              "class": "col-md-12",
              "components": [
                {
                  "events": {
                    "click": [
                      {
                        "path": "add-software-modulescatlist",
                        "then": [
                          {
                            "code": "await grid0.Reload();",
                            "type": "execute"
                          },
                          {
                            "code": "await InvokeAsync(() => { StateHasChanged(); });",
                            "type": "execute"
                          }
                        ],
                        "type": "popup"
                      }
                    ]
                  },
                  "icon": "add_circle_outline",
                  "name": "button0",
                  "style": {
                    "marginBottom": "10px"
                  },
                  "text": "Add",
                  "type": "button"
                },
                {
                  "attributes": [
                    {
                      "name": "@oninput",
                      "value": "@(async(args) => {search = $\"{args.Value}\";await grid0.GoToPage(0);await grid0.Reload();})"
                    }
                  ],
                  "name": "textbox0",
                  "placeholder": "Search ...",
                  "style": {
                    "display": "block",
                    "marginBottom": "10px",
                    "width": "100%"
                  },
                  "type": "textbox",
                  "value": ""
                },
                {
                  "allowFiltering": true,
                  "allowPaging": true,
                  "allowSorting": true,
                  "columns": [
                    {
                      "property": "sprModulecatid",
                      "title": "Spr Modulecatid"
                    },
                    {
                      "property": "sprModulecatDesc",
                      "title": "Spr Modulecat Desc"
                    },
                    {
                      "property": "sprModulecatDesc1",
                      "title": "Spr Modulecat Desc 1"
                    },
                    {
                      "property": "FuturecatDesc",
                      "title": "Futurecat Desc"
                    },
                    {
                      "property": "FuturecatDesc1",
                      "title": "Futurecat Desc 1"
                    },
                    {
                      "property": "InstallcatModule",
                      "title": "Installcat Module"
                    },
                    {
                      "property": "photopath",
                      "title": "Photopath"
                    },
                    {
                      "filterable": false,
                      "sortable": false,
                      "template": [
                        {
                          "attributes": [
                            {
                              "name": "@onclick:stopPropagation",
                              "value": true
                            }
                          ],
                          "buttonStyle": "danger",
                          "events": {
                            "click": [
                              {
                                "condition": "await DialogService.Confirm(\"Are you sure you want to delete this record?\") == true",
                                "error": [
                                  {
                                    "detail": "Unable to delete SoftwareModulescatlist",
                                    "severity": "error",
                                    "summary": "Error",
                                    "type": "notify"
                                  }
                                ],
                                "name": "authenticationconn.deleteSoftwareModulescatlist",
                                "parameters": [
                                  {
                                    "name": "sprModulecatid",
                                    "value": "${data.sprModulecatid}"
                                  }
                                ],
                                "then": [
                                  {
                                    "code": "await grid0.Reload();",
                                    "condition": "result != null",
                                    "type": "execute"
                                  }
                                ],
                                "type": "invoke"
                              }
                            ]
                          },
                          "icon": "close",
                          "name": "gridDeleteButton",
                          "size": "sm",
                          "text": "",
                          "type": "button"
                        }
                      ],
                      "textAlign": "center",
                      "width": "70px"
                    }
                  ],
                  "count": "${getSoftwareModulescatlistsCount}",
                  "data": "${getSoftwareModulescatlistsResult}",
                  "events": {
                    "loadData": [
                      {
                        "error": [
                          {
                            "detail": "Unable to load SoftwareModulescatlists",
                            "severity": "error",
                            "summary": "Error",
                            "type": "notify"
                          }
                        ],
                        "name": "authenticationconn.getSoftwareModulescatlists",
                        "parameters": [
                          {
                            "name": "$top",
                            "value": "event.top"
                          },
                          {
                            "name": "$skip",
                            "value": "event.skip"
                          },
                          {
                            "name": "$count",
                            "value": "event.top != null && event.skip != null"
                          },
                          {
                            "name": "$filter",
                            "operator": "and",
                            "value": [
                              {
                                "filters": [
                                  {
                                    "operation": "contains",
                                    "property": "sprModulecatDesc",
                                    "type": "string",
                                    "value": "\"${search}\""
                                  },
                                  {
                                    "operation": "contains",
                                    "property": "sprModulecatDesc1",
                                    "type": "string",
                                    "value": "\"${search}\""
                                  },
                                  {
                                    "operation": "contains",
                                    "property": "FuturecatDesc",
                                    "type": "string",
                                    "value": "\"${search}\""
                                  },
                                  {
                                    "operation": "contains",
                                    "property": "FuturecatDesc1",
                                    "type": "string",
                                    "value": "\"${search}\""
                                  },
                                  {
                                    "operation": "contains",
                                    "property": "photopath",
                                    "type": "string",
                                    "value": "\"${search}\""
                                  }
                                ],
                                "operator": "or"
                              },
                              {
                                "value": "${(string.IsNullOrEmpty(event.filter)? \"true\" : event.filter)}"
                              }
                            ]
                          },
                          {
                            "name": "$orderby",
                            "value": [
                              {
                                "value": "${event.orderby}"
                              }
                            ]
                          }
                        ],
                        "then": [
                          {
                            "name": "getSoftwareModulescatlistsResult",
                            "type": "set",
                            "value": "${result.Value.AsODataEnumerable()}",
                            "valueType": "IEnumerable<Cpdhelpdesk.Models.Authenticationconn.SoftwareModulescatlist>"
                          },
                          {
                            "name": "getSoftwareModulescatlistsCount",
                            "type": "set",
                            "value": "${result.Count}",
                            "valueType": "int"
                          }
                        ],
                        "type": "invoke"
                      }
                    ],
                    "rowSelect": [
                      {
                        "parameters": [
                          {
                            "name": "sprModulecatid",
                            "value": "${event.sprModulecatid}"
                          }
                        ],
                        "path": "edit-software-modulescatlist",
                        "then": [
                          {
                            "code": "await grid0.Reload();",
                            "type": "execute"
                          },
                          {
                            "code": "await InvokeAsync(() => { StateHasChanged(); });",
                            "type": "execute"
                          }
                        ],
                        "type": "popup"
                      }
                    ]
                  },
                  "filterMode": "advanced",
                  "itemType": "Cpdhelpdesk.Models.Authenticationconn.SoftwareModulescatlist",
                  "name": "grid0",
                  "title": "",
                  "type": "datagrid"
                }
              ],
              "type": "col"
            }
          ],
          "type": "row"
        }
      ],
      "container": "main",
      "type": "content"
    },
    {
      "style": {
        "backgroundColor": "#414141",
        "border": "1px solid rgba(0, 0, 0, 0)",
        "color": "#414141",
        "display": "block",
        "float": "none",
        "fontWeight": "bold",
        "height": "1227px",
        "position": "absolute",
        "visibility": "visible",
        "width": "251px",
        "zIndex": "3"
      }
    },
    {
      "style": {
        "backgroundColor": "#414141",
        "border": "1px solid rgba(0, 0, 0, 0)",
        "color": "#414141",
        "display": "block",
        "float": "none",
        "fontWeight": "bold",
        "height": "1227px",
        "position": "absolute",
        "visibility": "visible",
        "width": "251px",
        "zIndex": "3"
      }
    }
  ],
  "events": {
    "load": [
      {
        "condition": "string.IsNullOrEmpty(search)",
        "name": "search",
        "type": "set",
        "value": "\"\"",
        "valueType": "string"
      }
    ]
  },
  "layout": "widelayout",
  "name": "SoftwareModulescatlist"
}