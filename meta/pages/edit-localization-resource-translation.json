{
  "components": [
    {
      "type": "content",
      "container": "main",
      "components": [
        {
          "components": [
            {
              "class": "col-md-9",
              "components": [
                {
                  "name": "closeLabel",
                  "style": {
                    "fontWeight": "bold"
                  },
                  "text": "Item no longer available.",
                  "type": "label",
                  "visible": "${!canEdit}"
                }
              ],
              "name": "col0",
              "type": "col"
            },
            {
              "class": "col-md-3",
              "components": [
                {
                  "buttonStyle": "secondary",
                  "events": {
                    "click": [
                      {
                        "type": "close-popup"
                      }
                    ]
                  },
                  "icon": "",
                  "name": "closeButton",
                  "style": {
                    "marginBottom": "20px"
                  },
                  "text": "Close",
                  "type": "button",
                  "visible": "${!canEdit}"
                }
              ],
              "name": "col1",
              "type": "col"
            }
          ],
          "name": "row0",
          "style": {},
          "type": "row"
        },
        {
          "components": [
            {
              "class": "col-md-9",
              "components": [
                {
                  "name": "label0",
                  "style": {
                    "fontWeight": "bold"
                  },
                  "text": "Another user has made conflicting changes to one or more of the fields you have modified. Please reload.",
                  "type": "label",
                  "visible": "${hasChanges}"
                }
              ],
              "name": "col0",
              "type": "col"
            },
            {
              "class": "col-md-3",
              "components": [
                {
                  "buttonStyle": "secondary",
                  "events": {
                    "click": [
                      {
                        "code": "await this.Load()",
                        "type": "execute"
                      }
                    ]
                  },
                  "icon": "autorenew",
                  "name": "button0",
                  "style": {
                    "marginBottom": "20px"
                  },
                  "text": "Reload",
                  "type": "button",
                  "visible": "${hasChanges}"
                }
              ],
              "name": "col1",
              "type": "col"
            }
          ],
          "name": "row0",
          "style": {},
          "type": "row"
        },
        {
          "type": "row",
          "components": [
            {
              "type": "col",
              "class": "col-md-12",
              "components": [
                {
                  "type": "template-form",
                  "name": "form0",
                  "components": [
                    {
                      "type": "row",
                      "style": {
                        "marginBottom": "1rem"
                      },
                      "components": [
                        {
                          "type": "col",
                          "class": "col-md-3",
                          "components": [
                            {
                              "type": "label",
                              "text": "Language",
                              "component": "Language",
                              "name": "LanguageLabel",
                              "style": {
                                "width": "100%"
                              }
                            }
                          ]
                        },
                        {
                          "type": "col",
                          "class": "col-md-9",
                          "components": [
                            {
                              "valueType": "string",
                              "maxLength": 10,
                              "type": "textbox",
                              "name": "Language",
                              "style": {
                                "display": "block",
                                "width": "100%"
                              },
                              "value": "${localizationresourcetranslation.Language}"
                            },
                            {
                              "type": "required-validator",
                              "name": "LanguageRequiredValidator",
                              "component": "Language",
                              "text": "Language is required",
                              "style": {
                                "position": "absolute"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "style": {
                        "marginBottom": "1rem"
                      },
                      "components": [
                        {
                          "type": "col",
                          "class": "col-md-3",
                          "components": [
                            {
                              "type": "label",
                              "text": "Localization Resource",
                              "component": "ResourceId",
                              "name": "ResourceIdLabel",
                              "style": {
                                "width": "100%"
                              }
                            }
                          ]
                        },
                        {
                          "type": "col",
                          "class": "col-md-9",
                          "components": [
                            {
                              "data": "${getLocalizationResourcesForResourceIdResult}",
                              "textProperty": "Author",
                              "valueProperty": "Id",
                              "placeholder": "Choose LocalizationResource",
                              "valueType": "int",
                              "showSearch": false,
                              "count": "${getLocalizationResourcesForResourceIdCount}",
                              "value": "${localizationresourcetranslation.ResourceId}",
                              "type": "dropdown-datagrid",
                              "name": "ResourceId",
                              "style": {
                                "display": "block",
                                "width": "100%"
                              },
                              "selectedValue": "${getByLocalizationResourcesForResourceIdResult}",
                              "events": {
                                "loadData": [
                                  {
                                    "name": "authenticationconn.getLocalizationResources",
                                    "parameters": [
                                      {
                                        "name": "$top",
                                        "value": "${event.top}"
                                      },
                                      {
                                        "name": "$skip",
                                        "value": "${event.skip}"
                                      },
                                      {
                                        "name": "$orderby",
                                        "value": "${event.orderby}"
                                      },
                                      {
                                        "name": "$filter",
                                        "value": "${event.filter}"
                                      },
                                      {
                                        "name": "$count",
                                        "value": "true"
                                      }
                                    ],
                                    "then": [
                                      {
                                        "name": "getLocalizationResourcesForResourceIdResult",
                                        "type": "set",
                                        "value": "${result.Value.AsODataEnumerable()}",
                                        "valueType": "IEnumerable<Cpdhelpdesk.Models.Authenticationconn.LocalizationResource>"
                                      },
                                      {
                                        "name": "getLocalizationResourcesForResourceIdCount",
                                        "type": "set",
                                        "value": "result.Count"
                                      }
                                    ],
                                    "type": "invoke"
                                  }
                                ]
                              }
                            },
                            {
                              "type": "required-validator",
                              "name": "ResourceIdRequiredValidator",
                              "component": "ResourceId",
                              "text": "ResourceId is required",
                              "style": {
                                "position": "absolute"
                              },
                              "defaultValue": "0"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "style": {
                        "marginBottom": "1rem"
                      },
                      "components": [
                        {
                          "type": "col",
                          "class": "col-md-3",
                          "components": [
                            {
                              "type": "label",
                              "text": "Value",
                              "component": "Value",
                              "name": "ValueLabel",
                              "style": {
                                "width": "100%"
                              }
                            }
                          ]
                        },
                        {
                          "type": "col",
                          "class": "col-md-9",
                          "components": [
                            {
                              "valueType": "string",
                              "type": "textbox",
                              "name": "Value",
                              "style": {
                                "width": "100%"
                              },
                              "value": "${localizationresourcetranslation.Value}"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "style": {
                        "marginBottom": "1rem"
                      },
                      "components": [
                        {
                          "type": "col",
                          "class": "col-md-3",
                          "components": [
                            {
                              "type": "label",
                              "text": "Modification Date",
                              "component": "ModificationDate",
                              "name": "ModificationDateLabel",
                              "style": {
                                "width": "100%"
                              }
                            }
                          ]
                        },
                        {
                          "type": "col",
                          "class": "col-md-9",
                          "components": [
                            {
                              "valueType": "DateTime",
                              "dateFormat": "MM/dd/yyyy",
                              "type": "datepicker",
                              "name": "ModificationDate",
                              "style": {
                                "display": "block",
                                "width": "100%"
                              },
                              "value": "${localizationresourcetranslation.ModificationDate}"
                            },
                            {
                              "type": "required-validator",
                              "name": "ModificationDateRequiredValidator",
                              "component": "ModificationDate",
                              "text": "ModificationDate is required",
                              "style": {
                                "position": "absolute"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "components": [
                        {
                          "type": "col",
                          "class": "col offset-sm-3",
                          "components": [
                            {
                              "type": "button",
                              "buttonType": "submit",
                              "icon": "save",
                              "text": "Save",
                              "buttonStyle": "primary"
                            },
                            {
                              "type": "button",
                              "buttonStyle": "light",
                              "style": {
                                "marginLeft": "1rem"
                              },
                              "text": "Cancel",
                              "events": {
                                "click": [
                                  {
                                    "type": "close-popup"
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "events": {
                    "submit": [
                      {
                        "error": [
                          {
                            "detail": "Unable to update LocalizationResourceTranslation",
                            "severity": "error",
                            "summary": "Error",
                            "type": "notify"
                          },
                          {
                            "name": "hasChanges",
                            "type": "set",
                            "value": "result.Message.Contains(\"412\")",
                            "valueType": "bool"
                          },
                          {
                            "name": "canEdit",
                            "type": "set",
                            "condition": "!result.Message.Contains(\"412\")",
                            "value": "false",
                            "valueType": "bool"
                          }
                        ],
                        "name": "authenticationconn.updateLocalizationResourceTranslation",
                        "parameters": [
                          {
                            "name": "Id",
                            "value": "${parameters.Id}"
                          },
                          {
                            "name": "LocalizationResourceTranslation",
                            "value": "${localizationresourcetranslation}"
                          }
                        ],
                        "then": [
                          {
                            "type": "close-popup",
                            "result": "${localizationresourcetranslation}",
                            "condition": "result.StatusCode != System.Net.HttpStatusCode.PreconditionFailed"
                          },
                          {
                            "name": "hasChanges",
                            "type": "set",
                            "value": "result.StatusCode == System.Net.HttpStatusCode.PreconditionFailed",
                            "valueType": "bool"
                          }
                        ],
                        "type": "invoke"
                      }
                    ]
                  },
                  "itemType": "Cpdhelpdesk.Models.Authenticationconn.LocalizationResourceTranslation",
                  "data": "${localizationresourcetranslation}",
                  "visible": "${localizationresourcetranslation != null && canEdit}"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "events": {
    "load": [
      {
        "name": "hasChanges",
        "type": "set",
        "value": "false",
        "valueType": "bool"
      },
      {
        "name": "canEdit",
        "type": "set",
        "value": "true",
        "valueType": "bool"
      },
      {
        "name": "authenticationconn.getLocalizationResourceTranslationById",
        "parameters": [
          {
            "name": "Id",
            "value": "${parameters.Id}"
          }
        ],
        "then": [
          {
            "name": "localizationresourcetranslation",
            "type": "set",
            "value": "${result}",
            "valueType": "Cpdhelpdesk.Models.Authenticationconn.LocalizationResourceTranslation"
          },
          {
            "name": "canEdit",
            "type": "set",
            "value": "result != null",
            "valueType": "bool"
          },
          {
            "name": "authenticationconn.getLocalizationResourceById",
            "parameters": [
              {
                "name": "Id",
                "value": "${this.localizationresourcetranslation.ResourceId}"
              }
            ],
            "then": [
              {
                "name": "getByLocalizationResourcesForResourceIdResult",
                "type": "set",
                "value": "${result}",
                "valueType": "Cpdhelpdesk.Models.Authenticationconn.LocalizationResource"
              }
            ],
            "condition": "this.localizationresourcetranslation.ResourceId != null",
            "type": "invoke"
          }
        ],
        "error": [],
        "type": "invoke"
      }
    ]
  },
  "name": "Edit Localization Resource Translation",
  "access": [
    "Authenticated"
  ],
  "layout": "Main"
}