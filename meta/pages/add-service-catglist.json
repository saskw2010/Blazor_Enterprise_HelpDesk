{
  "components": [
    {
      "type": "content",
      "container": "main",
      "components": [
        {
          "type": "row",
          "components": [
            {
              "type": "col",
              "class": "col-md-12",
              "components": [
                {
                  "type": "template-form",
                  "name": "form0",
                  "components": [
                    {
                      "type": "row",
                      "style": {
                        "marginBottom": "1rem"
                      },
                      "components": [
                        {
                          "type": "col",
                          "class": "col-md-3",
                          "components": [
                            {
                              "type": "label",
                              "text": "Service Catg Desc",
                              "component": "ServiceCatgDesc",
                              "name": "ServiceCatgDescLabel",
                              "style": {
                                "width": "100%"
                              }
                            }
                          ]
                        },
                        {
                          "type": "col",
                          "class": "col-md-9",
                          "components": [
                            {
                              "valueType": "string",
                              "maxLength": 250,
                              "type": "textbox",
                              "name": "ServiceCatgDesc",
                              "style": {
                                "width": "100%"
                              },
                              "value": "${servicecatglist.ServiceCatgDesc}"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "style": {
                        "marginBottom": "1rem"
                      },
                      "components": [
                        {
                          "type": "col",
                          "class": "col-md-3",
                          "components": [
                            {
                              "type": "label",
                              "text": "Service Catg Desc 1",
                              "component": "ServiceCatgDesc1",
                              "name": "ServiceCatgDesc1Label",
                              "style": {
                                "width": "100%"
                              }
                            }
                          ]
                        },
                        {
                          "type": "col",
                          "class": "col-md-9",
                          "components": [
                            {
                              "valueType": "string",
                              "maxLength": 250,
                              "type": "textbox",
                              "name": "ServiceCatgDesc1",
                              "style": {
                                "width": "100%"
                              },
                              "value": "${servicecatglist.ServiceCatgDesc1}"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "style": {
                        "marginBottom": "1rem"
                      },
                      "components": [
                        {
                          "type": "col",
                          "class": "col-md-3",
                          "components": [
                            {
                              "type": "label",
                              "text": "Audit Cc",
                              "component": "AuditCC",
                              "name": "AuditCCLabel",
                              "style": {
                                "width": "100%"
                              }
                            }
                          ]
                        },
                        {
                          "type": "col",
                          "class": "col-md-9",
                          "components": [
                            {
                              "valueType": "string",
                              "maxLength": 250,
                              "type": "textbox",
                              "name": "AuditCC",
                              "style": {
                                "width": "100%"
                              },
                              "value": "${servicecatglist.AuditCC}"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "style": {
                        "marginBottom": "1rem"
                      },
                      "components": [
                        {
                          "type": "col",
                          "class": "col-md-3",
                          "components": [
                            {
                              "type": "label",
                              "text": "Assign To",
                              "component": "assignTo",
                              "name": "assignToLabel",
                              "style": {
                                "width": "100%"
                              }
                            }
                          ]
                        },
                        {
                          "type": "col",
                          "class": "col-md-9",
                          "components": [
                            {
                              "valueType": "string",
                              "maxLength": 250,
                              "type": "textbox",
                              "name": "assignTo",
                              "style": {
                                "width": "100%"
                              },
                              "value": "${servicecatglist.assignTo}"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "components": [
                        {
                          "type": "col",
                          "class": "col offset-sm-3",
                          "components": [
                            {
                              "type": "button",
                              "buttonType": "submit",
                              "icon": "save",
                              "text": "Save",
                              "buttonStyle": "primary"
                            },
                            {
                              "type": "button",
                              "buttonStyle": "light",
                              "style": {
                                "marginLeft": "1rem"
                              },
                              "text": "Cancel",
                              "events": {
                                "click": [
                                  {
                                    "type": "close-popup"
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "events": {
                    "submit": [
                      {
                        "error": [
                          {
                            "detail": "Unable to create new ServiceCatglist!",
                            "severity": "error",
                            "summary": "Error",
                            "type": "notify"
                          }
                        ],
                        "name": "authenticationconn.createServiceCatglist",
                        "parameters": [
                          {
                            "name": "ServiceCatglist",
                            "value": "${servicecatglist}"
                          }
                        ],
                        "then": [
                          {
                            "type": "close-popup",
                            "result": "${servicecatglist}"
                          }
                        ],
                        "type": "invoke"
                      }
                    ]
                  },
                  "data": "${servicecatglist}",
                  "visible": "${servicecatglist != null}",
                  "itemType": "Cpdhelpdesk.Models.Authenticationconn.ServiceCatglist"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "events": {
    "load": [
      {
        "name": "servicecatglist",
        "type": "set",
        "value": "new Cpdhelpdesk.Models.Authenticationconn.ServiceCatglist(){}",
        "valueType": "Cpdhelpdesk.Models.Authenticationconn.ServiceCatglist"
      }
    ]
  },
  "name": "Add Service Catglist",
  "access": [
    "Authenticated"
  ],
  "layout": "Main"
}