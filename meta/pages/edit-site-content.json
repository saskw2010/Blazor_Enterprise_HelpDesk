                          ]
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "components": [
                        {
                          "type": "col",
                          "class": "col offset-sm-3",
                          "components": [
                            {
                              "type": "button",
                              "buttonType": "submit",
                              "icon": "save",
                              "text": "Save",
                              "buttonStyle": "primary"
                            },
                            {
                              "type": "button",
                              "buttonStyle": "light",
                              "style": {
                                "marginLeft": "1rem"
                              },
                              "text": "Cancel",
                              "events": {
                                "click": [
                                  {
                                    "type": "close-popup"
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "events": {
                    "submit": [
                      {
                        "error": [
                          {
                            "detail": "Unable to update SiteContent",
                            "severity": "error",
                            "summary": "Error",
                            "type": "notify"
                          },
                          {
                            "name": "hasChanges",
                            "type": "set",
                            "value": "result.Message.Contains(\"412\")",
                            "valueType": "bool"
                          },
                          {
                            "name": "canEdit",
                            "type": "set",
                            "condition": "!result.Message.Contains(\"412\")",
                            "value": "false",
                            "valueType": "bool"
                          }
                        ],
                        "name": "authenticationconn.updateSiteContent",
                        "parameters": [
                          {
                            "name": "SiteContentID",
                            "value": "${parameters.SiteContentID}"
                          },
                          {
                            "name": "SiteContent",
                            "value": "${sitecontent}"
                          }
                        ],
                        "then": [
                          {
                            "type": "close-popup",
                            "result": "${sitecontent}",
                            "condition": "result.StatusCode != System.Net.HttpStatusCode.PreconditionFailed"
                          },
                          {
                            "name": "hasChanges",
                            "type": "set",
                            "value": "result.StatusCode == System.Net.HttpStatusCode.PreconditionFailed",
                            "valueType": "bool"
                          }
                        ],
                        "type": "invoke"
                      }
                    ]
                  },
                  "itemType": "Cpdhelpdesk.Models.Authenticationconn.SiteContent",
                  "data": "${sitecontent}",
                  "visible": "${sitecontent != null && canEdit}"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "events": {
    "load": [
      {
        "name": "hasChanges",
        "type": "set",
        "value": "false",
        "valueType": "bool"
      },
      {
        "name": "canEdit",
        "type": "set",
        "value": "true",
        "valueType": "bool"
      },
      {
        "name": "authenticationconn.getSiteContentBySiteContentID",
        "parameters": [
          {
            "name": "SiteContentID",
            "value": "${parameters.SiteContentID}"
          }
        ],
        "then": [
          {
            "name": "sitecontent",
            "type": "set",
            "value": "${result}",
            "valueType": "Cpdhelpdesk.Models.Authenticationconn.SiteContent"
          },
          {
            "name": "canEdit",
            "type": "set",
            "value": "result != null",
            "valueType": "bool"
          }
        ],
        "error": [],
        "type": "invoke"
      }
    ]
  },
  "name": "Edit Site Content",
  "access": [
    "Authenticated"
  ],
  "layout": "Main"
}