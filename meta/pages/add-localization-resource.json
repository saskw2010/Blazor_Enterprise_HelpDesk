{
  "components": [
    {
      "type": "content",
      "container": "main",
      "components": [
        {
          "type": "row",
          "components": [
            {
              "type": "col",
              "class": "col-md-12",
              "components": [
                {
                  "type": "template-form",
                  "name": "form0",
                  "components": [
                    {
                      "type": "row",
                      "style": {
                        "marginBottom": "1rem"
                      },
                      "components": [
                        {
                          "type": "col",
                          "class": "col-md-3",
                          "components": [
                            {
                              "type": "label",
                              "text": "Author",
                              "component": "Author",
                              "name": "AuthorLabel",
                              "style": {
                                "width": "100%"
                              }
                            }
                          ]
                        },
                        {
                          "type": "col",
                          "class": "col-md-9",
                          "components": [
                            {
                              "valueType": "string",
                              "maxLength": 100,
                              "type": "textbox",
                              "name": "Author",
                              "style": {
                                "display": "block",
                                "width": "100%"
                              },
                              "value": "${localizationresource.Author}"
                            },
                            {
                              "type": "required-validator",
                              "name": "AuthorRequiredValidator",
                              "component": "Author",
                              "text": "Author is required",
                              "style": {
                                "position": "absolute"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "style": {
                        "marginBottom": "1rem"
                      },
                      "components": [
                        {
                          "type": "col",
                          "class": "col-md-3",
                          "components": [
                            {
                              "type": "label",
                              "text": "From Code",
                              "component": "FromCode",
                              "name": "FromCodeLabel",
                              "style": {
                                "width": "100%"
                              }
                            }
                          ]
                        },
                        {
                          "type": "col",
                          "class": "col-md-9",
                          "components": [
                            {
                              "valueType": "bool",
                              "type": "checkbox",
                              "name": "FromCode",
                              "value": "${localizationresource.FromCode}"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "style": {
                        "marginBottom": "1rem"
                      },
                      "components": [
                        {
                          "type": "col",
                          "class": "col-md-3",
                          "components": [
                            {
                              "type": "label",
                              "text": "Is Hidden",
                              "component": "IsHidden",
                              "name": "IsHiddenLabel",
                              "style": {
                                "width": "100%"
                              }
                            }
                          ]
                        },
                        {
                          "type": "col",
                          "class": "col-md-9",
                          "components": [
                            {
                              "valueType": "bool",
                              "type": "checkbox",
                              "name": "IsHidden",
                              "value": "${localizationresource.IsHidden}"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "style": {
                        "marginBottom": "1rem"
                      },
                      "components": [
                        {
                          "type": "col",
                          "class": "col-md-3",
                          "components": [
                            {
                              "type": "label",
                              "text": "Is Modified",
                              "component": "IsModified",
                              "name": "IsModifiedLabel",
                              "style": {
                                "width": "100%"
                              }
                            }
                          ]
                        },
                        {
                          "type": "col",
                          "class": "col-md-9",
                          "components": [
                            {
                              "valueType": "bool",
                              "type": "checkbox",
                              "name": "IsModified",
                              "value": "${localizationresource.IsModified}"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "style": {
                        "marginBottom": "1rem"
                      },
                      "components": [
                        {
                          "type": "col",
                          "class": "col-md-3",
                          "components": [
                            {
                              "type": "label",
                              "text": "Modification Date",
                              "component": "ModificationDate",
                              "name": "ModificationDateLabel",
                              "style": {
                                "width": "100%"
                              }
                            }
                          ]
                        },
                        {
                          "type": "col",
                          "class": "col-md-9",
                          "components": [
                            {
                              "valueType": "DateTime",
                              "dateFormat": "MM/dd/yyyy",
                              "type": "datepicker",
                              "name": "ModificationDate",
                              "style": {
                                "display": "block",
                                "width": "100%"
                              },
                              "value": "${localizationresource.ModificationDate}"
                            },
                            {
                              "type": "required-validator",
                              "name": "ModificationDateRequiredValidator",
                              "component": "ModificationDate",
                              "text": "ModificationDate is required",
                              "style": {
                                "position": "absolute"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "style": {
                        "marginBottom": "1rem"
                      },
                      "components": [
                        {
                          "type": "col",
                          "class": "col-md-3",
                          "components": [
                            {
                              "type": "label",
                              "text": "Resource Key",
                              "component": "ResourceKey",
                              "name": "ResourceKeyLabel",
                              "style": {
                                "width": "100%"
                              }
                            }
                          ]
                        },
                        {
                          "type": "col",
                          "class": "col-md-9",
                          "components": [
                            {
                              "valueType": "string",
                              "maxLength": 1000,
                              "type": "textbox",
                              "name": "ResourceKey",
                              "style": {
                                "display": "block",
                                "width": "100%"
                              },
                              "value": "${localizationresource.ResourceKey}"
                            },
                            {
                              "type": "required-validator",
                              "name": "ResourceKeyRequiredValidator",
                              "component": "ResourceKey",
                              "text": "ResourceKey is required",
                              "style": {
                                "position": "absolute"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "style": {
                        "marginBottom": "1rem"
                      },
                      "components": [
                        {
                          "type": "col",
                          "class": "col-md-3",
                          "components": [
                            {
                              "type": "label",
                              "text": "Notes",
                              "component": "Notes",
                              "name": "NotesLabel",
                              "style": {
                                "width": "100%"
                              }
                            }
                          ]
                        },
                        {
                          "type": "col",
                          "class": "col-md-9",
                          "components": [
                            {
                              "valueType": "string",
                              "maxLength": 3000,
                              "type": "textbox",
                              "name": "Notes",
                              "style": {
                                "width": "100%"
                              },
                              "value": "${localizationresource.Notes}"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "components": [
                        {
                          "type": "col",
                          "class": "col offset-sm-3",
                          "components": [
                            {
                              "type": "button",
                              "buttonType": "submit",
                              "icon": "save",
                              "text": "Save",
                              "buttonStyle": "primary"
                            },
                            {
                              "type": "button",
                              "buttonStyle": "light",
                              "style": {
                                "marginLeft": "1rem"
                              },
                              "text": "Cancel",
                              "events": {
                                "click": [
                                  {
                                    "type": "close-popup"
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "events": {
                    "submit": [
                      {
                        "error": [
                          {
                            "detail": "Unable to create new LocalizationResource!",
                            "severity": "error",
                            "summary": "Error",
                            "type": "notify"
                          }
                        ],
                        "name": "authenticationconn.createLocalizationResource",
                        "parameters": [
                          {
                            "name": "LocalizationResource",
                            "value": "${localizationresource}"
                          }
                        ],
                        "then": [
                          {
                            "type": "close-popup",
                            "result": "${localizationresource}"
                          }
                        ],
                        "type": "invoke"
                      }
                    ]
                  },
                  "data": "${localizationresource}",
                  "visible": "${localizationresource != null}",
                  "itemType": "Cpdhelpdesk.Models.Authenticationconn.LocalizationResource"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "events": {
    "load": [
      {
        "name": "localizationresource",
        "type": "set",
        "value": "new Cpdhelpdesk.Models.Authenticationconn.LocalizationResource(){}",
        "valueType": "Cpdhelpdesk.Models.Authenticationconn.LocalizationResource"
      }
    ]
  },
  "name": "Add Localization Resource",
  "access": [
    "Authenticated"
  ],
  "layout": "Main"
}