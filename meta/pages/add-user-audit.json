{
  "components": [
    {
      "type": "content",
      "container": "main",
      "components": [
        {
          "type": "row",
          "components": [
            {
              "type": "col",
              "class": "col-md-12",
              "components": [
                {
                  "type": "template-form",
                  "name": "form0",
                  "components": [
                    {
                      "type": "row",
                      "style": {
                        "marginBottom": "1rem"
                      },
                      "components": [
                        {
                          "type": "col",
                          "class": "col-md-3",
                          "components": [
                            {
                              "type": "label",
                              "text": "User Id",
                              "component": "UserId",
                              "name": "UserIdLabel",
                              "style": {
                                "width": "100%"
                              }
                            }
                          ]
                        },
                        {
                          "type": "col",
                          "class": "col-md-9",
                          "components": [
                            {
                              "valueType": "string",
                              "maxLength": 128,
                              "type": "textbox",
                              "name": "UserId",
                              "style": {
                                "width": "100%"
                              },
                              "value": "${useraudit.UserId}"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "style": {
                        "marginBottom": "1rem"
                      },
                      "components": [
                        {
                          "type": "col",
                          "class": "col-md-3",
                          "components": [
                            {
                              "type": "label",
                              "text": "Timestamp",
                              "component": "Timestamp",
                              "name": "TimestampLabel",
                              "style": {
                                "width": "100%"
                              }
                            }
                          ]
                        },
                        {
                          "type": "col",
                          "class": "col-md-9",
                          "components": [
                            {
                              "valueType": "DateTimeOffset?",
                              "type": "datepicker",
                              "name": "Timestamp",
                              "style": {
                                "width": "100%"
                              },
                              "value": "${useraudit.Timestamp}"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "style": {
                        "marginBottom": "1rem"
                      },
                      "components": [
                        {
                          "type": "col",
                          "class": "col-md-3",
                          "components": [
                            {
                              "type": "label",
                              "text": "Audit Event",
                              "component": "AuditEvent",
                              "name": "AuditEventLabel",
                              "style": {
                                "width": "100%"
                              }
                            }
                          ]
                        },
                        {
                          "type": "col",
                          "class": "col-md-9",
                          "components": [
                            {
                              "valueType": "string",
                              "maxLength": 50,
                              "type": "textbox",
                              "name": "AuditEvent",
                              "style": {
                                "width": "100%"
                              },
                              "value": "${useraudit.AuditEvent}"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "style": {
                        "marginBottom": "1rem"
                      },
                      "components": [
                        {
                          "type": "col",
                          "class": "col-md-3",
                          "components": [
                            {
                              "type": "label",
                              "text": "Ip Address",
                              "component": "IpAddress",
                              "name": "IpAddressLabel",
                              "style": {
                                "width": "100%"
                              }
                            }
                          ]
                        },
                        {
                          "type": "col",
                          "class": "col-md-9",
                          "components": [
                            {
                              "valueType": "string",
                              "maxLength": 50,
                              "type": "textbox",
                              "name": "IpAddress",
                              "style": {
                                "width": "100%"
                              },
                              "value": "${useraudit.IpAddress}"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "components": [
                        {
                          "type": "col",
                          "class": "col offset-sm-3",
                          "components": [
                            {
                              "type": "button",
                              "buttonType": "submit",
                              "icon": "save",
                              "text": "Save",
                              "buttonStyle": "primary"
                            },
                            {
                              "type": "button",
                              "buttonStyle": "light",
                              "style": {
                                "marginLeft": "1rem"
                              },
                              "text": "Cancel",
                              "events": {
                                "click": [
                                  {
                                    "type": "close-popup"
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "events": {
                    "submit": [
                      {
                        "error": [
                          {
                            "detail": "Unable to create new UserAudit!",
                            "severity": "error",
                            "summary": "Error",
                            "type": "notify"
                          }
                        ],
                        "name": "authenticationconn.createUserAudit",
                        "parameters": [
                          {
                            "name": "UserAudit",
                            "value": "${useraudit}"
                          }
                        ],
                        "then": [
                          {
                            "type": "close-popup",
                            "result": "${useraudit}"
                          }
                        ],
                        "type": "invoke"
                      }
                    ]
                  },
                  "data": "${useraudit}",
                  "visible": "${useraudit != null}",
                  "itemType": "Cpdhelpdesk.Models.Authenticationconn.UserAudit"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "events": {
    "load": [
      {
        "name": "useraudit",
        "type": "set",
        "value": "new Cpdhelpdesk.Models.Authenticationconn.UserAudit(){}",
        "valueType": "Cpdhelpdesk.Models.Authenticationconn.UserAudit"
      }
    ]
  },
  "name": "Add User Audit",
  "access": [
    "Authenticated"
  ],
  "layout": "Main"
}