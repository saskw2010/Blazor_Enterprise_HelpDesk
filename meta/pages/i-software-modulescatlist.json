{
  "access": "Authenticated",
  "components": [
    {
      "components": [
        {
          "components": [
            {
              "class": "col-md-12",
              "components": [
                {
                  "attributes": [
                    {
                      "name": "Top",
                      "value": "0px"
                    },
                    {
                      "name": "min-width",
                      "value": "250px"
                    },
                    {
                      "name": "clas",
                      "value": "profilemenumos"
                    }
                  ],
                  "name": "profilemenu0",
                  "style": {
                    "display": "inline-block",
                    "float": "right",
                    "height": "39px",
                    "marginTop": "1px",
                    "width": "200px"
                  },
                  "template": [
                    {
                      "text": "${Security.User?.Name}",
                      "type": "label"
                    }
                  ],
                  "type": "profilemenu",
                  "visible": "${Security.IsAuthenticated()}"
                },
                {
                  "attributes": [
                    {
                      "name": "class",
                      "value": "Headerbar1"
                    }
                  ],
                  "name": "pageTitle",
                  "size": "H1",
                  "style": {
                    "textAlign": "center"
                  },
                  "text": "البوابة الالكترونية لتطبيقات ديوان سمو ولى العهد",
                  "type": "heading"
                }
              ],
              "name": "col0",
              "type": "col"
            }
          ],
          "name": "row0",
          "type": "row"
        },
        {
          "attributes": [],
          "components": [
            {
              "class": "col-md-12",
              "components": [
                {
                  "allowPaging": true,
                  "count": "${getsoftcatcount}",
                  "data": "${getsoftcategory}",
                  "events": {
                    "loadData": [
                      {
                        "name": "authenticationconn.getSoftwareModulescatlists",
                        "then": [
                          {
                            "name": "getsoftcategory",
                            "type": "set",
                            "value": "${result.Value}",
                            "valueType": "IEnumerable<Cpdhelpdesk.Models.Authenticationconn.SoftwareModulescatlist>"
                          },
                          {
                            "name": "getsoftcatcount",
                            "type": "set",
                            "value": "${result.Count}",
                            "valueType": "int"
                          }
                        ],
                        "type": "invoke"
                      }
                    ]
                  },
                  "itemType": "Cpdhelpdesk.Models.Authenticationconn.SoftwareModulescatlist",
                  "name": "datalist0",
                  "pageSize": 98,
                  "style": {
                    "display": "inline-block"
                  },
                  "template": "<RadzenCard class=\"flipping-cards\">\n\n        <div class=\"flipping-card-wrapper\">\n            <div class=\"flipping-card-item-wrapper\">\n                <div class=\"flipping-card-item-side flipping-card-item-side-front\">\n                    <img src=\"/assets/images/geny.png\" alt=\"\" class=\"flipping-card-item-img\">\n                </div>\n                <div class=\"flipping-card-item-side flipping-card-item-side-back\">\n                    <div class=\"flipping-card-back-wrapper\">\n                        <p>Hello I am learning how to create flipping cards using HTML & CSS, will you mind joining me?</p>\n                        <button class=\"flipping-card-back-wrapper__btn\">Read More</button>\n                    </div>\n                </div>\n            </div>\n        </div>\n       \n\n </RadzenCard>\n\n",
                  "type": "datalist",
                  "wrapItems": true
                }
              ],
              "type": "col"
            }
          ],
          "type": "row"
        }
      ],
      "container": "main",
      "type": "content"
    },
    {
      "style": {
        "backgroundColor": "#414141",
        "border": "1px solid rgba(0, 0, 0, 0)",
        "color": "#414141",
        "display": "block",
        "float": "none",
        "fontWeight": "bold",
        "height": "1227px",
        "position": "absolute",
        "visibility": "visible",
        "width": "251px",
        "zIndex": "3"
      }
    },
    {
      "style": {
        "backgroundColor": "#414141",
        "border": "1px solid rgba(0, 0, 0, 0)",
        "color": "#414141",
        "display": "block",
        "float": "none",
        "fontWeight": "bold",
        "height": "1227px",
        "position": "absolute",
        "visibility": "visible",
        "width": "251px",
        "zIndex": "3"
      }
    }
  ],
  "events": {
    "load": []
  },
  "layout": "landingpage1",
  "name": "ISoftwareModulescatlist"
}