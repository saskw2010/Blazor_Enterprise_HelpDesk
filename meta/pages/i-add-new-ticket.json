                            "code": " await GlobalsService.SaveTicket(authenticationconnCreateHelpDeskTicketResult.TicketRequesterEmail, authenticationconnCreateHelpDeskTicketResult.TicketGUID, authenticationconnCreateHelpDeskTicketResult.Id, authenticationconnCreateHelpDeskTicketResult.AuditCC, authenticationconnCreateHelpDeskTicketResult.assignTo);\n \n\n  NotificationService.Notify(new NotificationMessage() { Severity = NotificationSeverity.Info, Summary = $\"done\", Detail = $\"sended\" });",
                            "type": "execute"
                          },
                          {
